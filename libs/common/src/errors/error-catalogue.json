    "AUTH_EMAIL_TAKEN": {
      "httpStatus": 409,
      "group": "Auth (identity)",
      "message": {
        "ar": "يوجد حساب مسجّل بهذا البريد الإلكتروني.",
        "en": "An account with this email already exists."
      },
      "hint": {
        "ar": "سجّل الدخول، أو استخدم بريدًا آخر.",
        "en": "Sign in, or use a different email."
      }
