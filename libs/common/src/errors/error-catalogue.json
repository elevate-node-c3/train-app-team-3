{
  "version": 1,
  "defaultLanguage": "ar",
  "supportedLanguages": [
    "ar",
    "en"
  ],
  "errors": {
    "VALIDATION_FAILED": {
      "httpStatus": 400,
      "group": "General",
      "message": {
        "ar": "بعض البيانات المرسلة غير صالحة.",
        "en": "Some of the information you sent is not valid."
      },
      "hint": {
        "ar": "صحّح الحقول المذكورة في التفاصيل ثم أعد إرسال الطلب.",
        "en": "Fix the fields listed in details and send the request again."
      }
