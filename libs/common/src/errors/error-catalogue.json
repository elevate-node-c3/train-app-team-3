        "ar": "استغرق الطلب وقتًا أطول من المسموح.",
        "en": "The request took longer than allowed."
      },
      "hint": {
        "ar": "راجع حجوزاتك قبل إعادة المحاولة.",
        "en": "Check your bookings before trying again."
      }
    },
