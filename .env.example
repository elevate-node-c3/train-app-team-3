# Shared application settings
NODE_ENV=development

# API Gateway
PORT_GATEWAY=3000
IDENTITY_GRPC_URL=localhost:50051

# Identity service database (local development)
IDENTITY_PORT=50051
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=identity_db

# PostgreSQL container settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
IDENTITY_DB_NAME=identity_db

# RabbitMQ container settings
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Redis container settings (leave empty to disable authentication)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT RSA keys: provide PEM contents with newlines represented as \n
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Notification service SMTP settings
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@example.com
