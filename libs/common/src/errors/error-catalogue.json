  "fieldErrors": {
    "FIELD_REQUIRED": {
      "message": {
        "ar": "{label} مطلوب.",
        "en": "{label} is required."
      },
      "hint": {
        "ar": "أدخل {label}.",
        "en": "Enter {label}."
      }
    },
    "FIELD_INVALID_FORMAT": {
      "message": {
        "ar": "صيغة {label} غير صحيحة.",
        "en": "{label} is not in the right format."
      },
      "hint": {
        "ar": "استخدم صيغة مثل {example}.",
        "en": "Use a format like {example}."
      }
    },
    "FIELD_TOO_SHORT": {
      "message": {
        "ar": "يجب ألا يقل {label} عن {min} أحرف.",
        "en": "{label} must be at least {min} characters."
      },
      "hint": {
        "ar": "اجعله أطول.",
        "en": "Make it longer."
      }
    },
    "FIELD_TOO_LONG": {
      "message": {
        "ar": "يجب ألا يزيد {label} عن {max} حرفًا.",
        "en": "{label} must be at most {max} characters."
      },
      "hint": {
        "ar": "اجعله أقصر.",
        "en": "Make it shorter."
      }
    },
    "FIELD_OUT_OF_RANGE": {
      "message": {
        "ar": "يجب أن يكون {label} بين {min} و{max}.",
        "en": "{label} must be between {min} and {max}."
      },
      "hint": {
        "ar": "أدخل قيمة ضمن هذا النطاق.",
        "en": "Enter a value in that range."
      }
    },
    "FIELD_INVALID_CHOICE": {
      "message": {
        "ar": "يجب أن يكون {label} أحد الخيارات: {allowed}.",
        "en": "{label} must be one of: {allowed}."
      },
      "hint": {
        "ar": "اختر إحدى القيم المسموحة.",
        "en": "Pick one of the allowed values."
      }
    },
    "FIELD_NOT_ALLOWED": {
      "message": {
        "ar": "الحقل {label} غير مقبول في هذا الطلب.",
        "en": "{label} is not accepted by this request."
      },
      "hint": {
        "ar": "احذفه وأعد الإرسال.",
        "en": "Remove it and send again."
      }
    }
  },
