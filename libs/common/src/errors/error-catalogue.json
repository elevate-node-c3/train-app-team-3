      "httpStatus": 503,
      "group": "General",
      "message": {
        "ar": "هذه الخدمة غير متاحة مؤقتًا.",
        "en": "This feature is temporarily unavailable."
      },
      "hint": {
        "ar": "حاول مرة أخرى بعد دقائق.",
        "en": "Try again in a few minutes."
      }
    },
