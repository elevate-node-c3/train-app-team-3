      "httpStatus": 409,
      "group": "Auth (identity)",
      "message": {
        "ar": "يوجد حساب مسجّل بهذا الرقم.",
        "en": "An account with this phone number already exists."
      },
      "hint": {
        "ar": "سجّل الدخول، أو استخدم رقمًا آخر.",
        "en": "Sign in, or use a different phone number."
      }
