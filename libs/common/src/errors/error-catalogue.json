      "httpStatus": 401,
      "group": "General",
      "message": {
        "ar": "الجلسة غير صالحة.",
        "en": "Your session is not valid."
      },
      "hint": {
        "ar": "سجّل الدخول من جديد.",
        "en": "Sign in again."
      }
