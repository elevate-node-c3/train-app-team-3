{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@app/contracts": [
        "libs/contracts/src"
      ],
      "@app/common": [
        "libs/common/src"
      ],
      "@app/observability": [
        "libs/observability/src"
      ],
      "@app/messaging": [
        "libs/messaging/src"
      ]
    }
  }
}