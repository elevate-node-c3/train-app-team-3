      "httpStatus": 400,
      "group": "Auth (identity)",
      "message": {
        "ar": "انتهت صلاحية رمز التحقق.",
        "en": "The verification code has expired."
      },
      "hint": {
        "ar": "اطلب رمزًا جديدًا.",
        "en": "Request a new code."
      }
